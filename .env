# URL of your BfxBridge Next.js Backend (Render or Vercel production URL)
BFX_BASE_URL=https://bfxbridge.onrender.com

# Shared secret key matching backend BRIDGE_AGENT_SECRET
BRIDGE_AGENT_SECRET=bfxbridge-secure-bridge-agent-secret-key-salt

# Path to MetaTrader 5 terminal executable on Linux (Wine)
MT5_TERMINAL_PATH=/root/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe

# Directory where isolated account instances are created
MT5_INSTANCES_DIR=/root/bridge-agent/instances

# Target X11 Display for MT5 GUI (:1 for VNC remote desktop, :0 for main display)
MT5_DISPLAY=:1
DISPLAY=:1

# Account sync polling interval in milliseconds
POLL_INTERVAL_MS=5000
